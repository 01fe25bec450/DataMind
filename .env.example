# ==============================================================================
# DataMind Environment Variables Template
# Stage 3: Gemma Natural-Language-to-SQL + Snowflake Integration
# ==============================================================================

# Snowflake Data Warehouse Configuration
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Gemma AI Model Runtime Configuration
# Choose Option A (Hosted Gemma via Google AI Studio) or Option B (Local Ollama)

# Option A: Google AI Studio Gemma API (e.g. gemma-2-2b-it or gemma-2-9b-it)
GEMMA_API_KEY=
GEMMA_MODEL=gemma-2-2b-it

# Option B: Local Ollama Runtime (e.g. gemma2:2b, gemma2:9b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
